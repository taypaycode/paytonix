# Copy to .env.local for local dev. Set the same vars in Vercel for production.
#
# 1. Create a Private App in your PRODUCTION HubSpot CRM (not the developer test account):
#    Settings > Integrations > Private Apps
#    Scopes: crm.schemas.contacts.read, crm.schemas.contacts.write, forms
# 2. Run: npm run provision:hubspot
#    (reads HUBSPOT_ACCESS_TOKEN, creates properties + forms, writes portal/form IDs below)

# Token: the Private App *access token* (pat-...), NOT the numeric app ID.
# HUBSPOT_MARTECHOS_SERVICE_KEY_ID in martechos/.env is the app ID only.
HUBSPOT_ACCESS_TOKEN=
# Or rely on martechos/.env → HUBSPOT_SERVICE_KEY (auto-loaded by provision script)

# Written by provision:hubspot — required for form submissions in the browser
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_ASSESSMENT_FORM_ID=
NEXT_PUBLIC_HUBSPOT_MARTECHOS_BETA_FORM_ID=

# Optional analytics (unchanged)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
